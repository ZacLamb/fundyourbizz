<%- include('partials/head') %>
<section class="page-hero"><div class="wrap">
  <p class="eyebrow">Contact</p>
  <h1>Talk to a funding advisor.</h1>
  <p class="lead">Ready to apply? <a href="/apply">Start your application</a>. Have questions first? Send a message or give us a call.</p>
</div></section>
<section class="sec"><div class="wrap split">
  <form class="panel" id="contactForm" novalidate>
    <h2>Send a message</h2>
    <div class="grid2">
      <label>Full name *<input name="name" required autocomplete="name"></label>
      <label>Business name<input name="company" autocomplete="organization"></label>
      <label>Email *<input name="email" type="email" required autocomplete="email"></label>
      <label>Phone *<input name="phone" type="tel" required autocomplete="tel"></label>
    </div>
    <label>How can we help?<textarea name="message" rows="5"></textarea></label>
    <input type="text" name="company_website_hp" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
    <p class="fine">By submitting, you agree to be contacted by Fund Your Bizz by phone, text and email about your inquiry. Msg &amp; data rates may apply. Reply STOP to opt out.</p>
    <button class="btn btn-green btn-block" type="submit">Send Message</button>
    <p class="form-msg" role="status"></p>
  </form>
  <div class="cards cards-1">
    <article class="card plain"><h3>Call</h3><p><a href="<%= site.phoneHref %>"><%= site.phone %></a></p></article>
    <article class="card plain"><h3>Email</h3><p><a href="mailto:<%= site.email %>"><%= site.email %></a></p></article>
    <article class="card plain"><h3>Office</h3><p><%= site.address.street %><br><%= site.address.city %>, <%= site.address.state %> <%= site.address.zip %></p></article>
    <article class="card plain"><h3>Hours</h3><p><%= site.hours %><br>Closed Saturday &amp; Sunday</p></article>
  </div>
</div></section>
<%- include('partials/foot') %>
