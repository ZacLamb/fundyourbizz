<%- include('partials/head') %>
<section class="page-hero has-img"><div class="wrap">
  <div>
  <p class="kicker load">Services</p>
  <h1 class="load d1">Funding and support for <em>growing</em> businesses.</h1>
  <p class="lead load d2">Our core product is revenue-based financing. We also help owners plan, structure and strengthen their finances.</p>
</div>
  <div class="ph-img load d2"><img src="/img/photos/contractor.jpeg" alt="Contractor reviewing plans with his crew"></div>
</div></section>

<section class="sec"><div class="wrap">
  <div class="cards cards-2">
    <article class="card feature">
      <p class="kicker">Core program</p>
      <h3>Revenue-Based Financing</h3>
      <p>$5,000 to $300,000 in upfront capital, repaid through automatic daily or weekly payments that can adjust with your revenue. Fixed total cost and an estimated 3–12 month term.</p>
      <a href="/revenue-based-financing" class="link">How RBF works →</a>
    </article>
    <article class="card feature">
      <p class="kicker">Flexible use</p>
      <h3>Working Capital</h3>
      <p>Cash for payroll, rent, inventory, marketing or covering a slow season — without giving up equity in your business.</p>
      <a href="/apply" class="link">Apply now →</a>
    </article>
    <article class="card feature">
      <p class="kicker">Tailored lending</p>
      <h3>Equipment &amp; Expansion Funding</h3>
      <p>Funding sized for bigger moves — new equipment, a second location, or a major contract you need to staff up for.</p>
      <a href="/apply" class="link">Apply now →</a>
    </article>
    <article class="card feature">
      <p class="kicker">When it can't wait</p>
      <h3>Emergency Funding</h3>
      <p>Fast access to capital for unexpected repairs, tax bills or cash-flow gaps.</p>
      <a href="/apply" class="link">Apply now →</a>
    </article>
  </div>
</div></section>

<section class="sec sec-alt"><div class="wrap">
  <div class="sec-head"><p class="kicker">Beyond funding</p><h2>Advisory services</h2></div>
