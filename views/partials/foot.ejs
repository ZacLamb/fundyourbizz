</main>
<% if (path !== '/apply' && path !== '/apply/thank-you') { %>
<section class="cta-band">
  <div class="cta-img"><img src="/img/photos/<%= typeof ctaPhoto !== 'undefined' ? ctaPhoto : 'trucker' %>.jpeg" alt="" loading="lazy"></div>
  <div class="wrap cta-in">
    <div class="rv">
      <p class="kicker light">Ten minutes. No obligation.</p>
      <h2>Find out what your business <em style="color:#8EE6B1">qualifies</em> for.</h2>
      <p>One application, real options, and a person who walks you through every number.</p>
    </div>
    <div class="cta-actions rv d2">
      <a href="/apply" class="btn btn-green btn-lg">Start Your Application <span class="arr">→</span></a>
      <a href="<%= site.phoneHref %>" class="btn btn-ghost-light btn-lg">Call <%= site.phone %></a>
    </div>
  </div>
</section>
<% } %>
<footer class="foot">
  <div class="wrap">
    <p class="foot-big" aria-hidden="true">Fund Your Bizz.</p>
    <div class="foot-grid">
      <div>
        <img src="<%= site.logo %>" alt="Fund Your Bizz" width="96" height="57" class="foot-logo">
        <p>Working capital for Main Street — $5,000 to $300,000, with terms built around your revenue.</p>
      </div>
      <div>
        <h4>Funding</h4>
        <a href="/revenue-based-financing">Revenue-Based Financing</a>
        <a href="/services">All Services</a>
        <a href="/how-it-works">How It Works</a>
        <a href="/apply">Apply Online</a>
      </div>
      <div>
        <h4>Company</h4>
        <a href="/about">About</a>
        <a href="/faq">FAQ</a>
        <a href="/contact">Contact</a>
        <a href="/privacy-policy">Privacy Policy</a>
        <a href="/terms-and-conditions">Terms &amp; Conditions</a>
      </div>
      <div>
        <h4>Get in touch</h4>
        <a href="<%= site.phoneHref %>"><%= site.phone %></a>
        <a href="mailto:<%= site.email %>"><%= site.email %></a>
        <p><%= site.address.street %><br><%= site.address.city %>, <%= site.address.state %> <%= site.address.zip %></p>
        <p class="muted"><%= site.hours %></p>
      </div>
    </div>
    <div class="foot-legal">
      <p>© <%= new Date().getFullYear() %> Fund Your Bizz. All rights reserved.</p>
      <p>Funding is subject to review and approval. Revenue-based financing is a purchase of future receivables, not a loan. Terms vary by business.</p>
    </div>
  </div>
</footer>
<script src="/js/main.js?v=5" defer></script>
</body>
</html>
