<%- include('partials/head') %>
<section class="page-hero tall"><div class="wrap narrow center">
  <div class="big-check">✓</div>
  <p class="eyebrow">Application received</p>
  <h1>Thank you — we've got it.</h1>
  <p class="lead">A Fund Your Bizz funding advisor is reviewing your application and bank statements now. Expect a call or text from <strong><%= site.phone %></strong>, usually within one business day.</p>
  <p class="lead" id="refLine" hidden>Your reference number: <strong id="refNo"></strong></p>
  <div class="hero-actions center">
    <a href="<%= site.phoneHref %>" class="btn btn-green btn-lg">Call <%= site.phone %></a>
    <a href="/" class="btn btn-ghost-light btn-lg">Back to Home</a>
  </div>
</div></section>
<script>
  try { const r = new URLSearchParams(location.search).get('ref'); if (r && /^[A-Z0-9]{4,10}$/.test(r)) { document.getElementById('refNo').textContent = r; document.getElementById('refLine').hidden = false; } } catch (e) {}
</script>
<%- include('partials/foot') %>
